+
+  /** Submit one rule's current slot on explicit human request, ignoring pause, enablement and shutdown. */
+  run(ruleId: string, now = Date.now()): ScheduleReceipt {
+    const rule = this.host.settings().schedule.rules.find(item => item.id === ruleId)
+    if (!rule) throw new UserError('unknownScheduleRule', { rule: ruleId })
+    const slot = Math.floor(now / (rule.everyMinutes * 60_000))
+    const receipt = this.submit(rule, slot)
+    this.host.store.set(KV.schedule.rule(rule.id), { everyMinutes: rule.everyMinutes, slot })
+    return { ruleId: rule.id, slot, triggerId: receipt.triggerId, outcome: receipt.outcome }
+  }
+
+  private submit(rule: Settings['schedule']['rules'][number], slot: number): InputReceipt {
+    return this.host.inputs.submit({ subjectId: this.host.subject.binding.subjectId, sourceId: 'local',
+      externalEventId: `schedule:${rule.id}:${slot}`, dedupeKey: `schedule:${rule.id}:${slot}`, layer: 'schedule', human: true,
+      payload: { text: rule.text }, provenance: { actor: 'orchestrator', note: 'Schedule' } })
+  }
 }
