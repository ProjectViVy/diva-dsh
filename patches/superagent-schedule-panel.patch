@@ -0,0 +1,69 @@
+/** Schedule settings group: interval and text for each local rule, plus a manual run for saved rules. */
+import type { Settings } from './api.ts'
+import { Button, Icon, Input, Switch } from './controls.tsx'
+import { SaveBar } from './draft.tsx'
+import { useAction, usePanel } from './provider.tsx'
+import { ConfigHistory, Field, Fields, numberOf, useBlockDraft, useSettings } from './settings-kit.tsx'
+import { Hint, Section } from './widgets.tsx'
+
+type Rule = Settings['schedule']['rules'][number]
+type DraftRule = Omit<Rule, 'everyMinutes'> & { everyMinutes: string }
+
+function RuleCard({ rule, saved, dirty, onChange, onRemove }: {
+  rule: DraftRule; saved: boolean; dirty: boolean; onChange: (rule: DraftRule) => void; onRemove: () => void
+}) {
+  const { t, call, notify } = usePanel()
+  const run = useAction(async () => {
+    const receipt = await call('POST schedule/:id/run', { id: rule.id })
+    notify(t(`scheduleRun.${receipt.outcome}`))
+  })
+  return <li className="dt-rule">
+    <div className="dt-rule-body">
+      <Field label={t('scheduleRuleId')} hint={t('scheduleRuleIdHint')}>
+        <Input value={rule.id} required maxLength={80} onChange={event => onChange({ ...rule, id: event.target.value })} />
+      </Field>
+      <Field label={t('scheduleEveryMinutes')} hint={t('scheduleEveryMinutesHint')}>
+        <Input type="number" min={1} max={10080} required value={rule.everyMinutes}
+          onChange={event => onChange({ ...rule, everyMinutes: event.target.value })} />
+      </Field>
+      <Field label={t('scheduleText')} hint={t('scheduleTextHint')}>
+        <textarea className="dt-textarea" rows={3} required maxLength={2000} value={rule.text}
+          onChange={event => onChange({ ...rule, text: event.target.value })} />
+      </Field>
+      <div className="dt-actions">
+        <Button variant="ghost" size="sm" icon={<Icon name="play" />} disabled={!saved || dirty || run.busy}
+          onClick={() => { void run.run() }}>{t('scheduleRun')}</Button>
+        <Button variant="ghost" size="sm" icon={<Icon name="trash" />} onClick={onRemove}>{t('remove')}</Button>
+      </div>
+    </div>
+    <Switch className="dt-rule-switch" checked={rule.enabled} onChange={enabled => onChange({ ...rule, enabled })}
+      label={t('scheduleRuleEnabled', { name: rule.id })} />
+  </li>
+}
+
+export function ScheduleSettings() {
+  const { t } = usePanel()
+  const block = useSettings().settings.blocks.schedule
+  const saved = { rules: block.value.rules.map(rule => ({ ...rule, everyMinutes: String(rule.everyMinutes) })) }
+  const draft = useBlockDraft('schedule', saved, block.revision,
+    value => ({ rules: value.rules.map(rule => ({ ...rule, everyMinutes: numberOf(rule.everyMinutes) })) }))
+  const rules = draft.value.rules
+  const savedIds = new Set(saved.rules.map(rule => rule.id))
+  const edit = (index: number, next: DraftRule) => draft.edit({ rules: rules.map((rule, at) => at === index ? next : rule) })
+  const add = () => draft.edit({ rules: [...rules, { id: crypto.randomUUID(), enabled: true, everyMinutes: '60', text: '' }] })
+  return <form className="dt-form dt-block" onSubmit={event => { void draft.submit(event) }}>
+    <Fields disabled={draft.busy}>
+      <h2 className="dt-block-title">{t('settingsGroup.schedule')}</h2>
+      <Section title={t('scheduleRules')} hint={t('scheduleRulesHint')} action={<Button variant="ghost" size="sm"
+        icon={<Icon name="plus" />} onClick={add}>{t('scheduleAddRule')}</Button>}>
+        {rules.length ? <ul className="dt-rules">{rules.map((rule, index) => <RuleCard key={index} rule={rule}
+          saved={savedIds.has(rule.id)} dirty={draft.dirty}
+          onChange={next => edit(index, next)}
+          onRemove={() => draft.edit({ rules: rules.filter((_, at) => at !== index) })} />)}</ul>
+          : <Hint>{t('scheduleEmpty')}</Hint>}
+      </Section>
+    </Fields>
+    <SaveBar {...draft} onDiscard={draft.discard} />
+    <ConfigHistory blocks={['schedule']} />
+  </form>
+}
