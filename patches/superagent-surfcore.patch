+it('copies a submitted channel onto the Trigger and its envelope, which is what gives replies a target', () => {
+  const channel = { source: 'local', thread: 'local:qq:123', address: { platform: 'qq', kind: 'group', target: '123' } }
+  const { store, inputs, received } = setup()
+  const receipt = inputs.submit({ ...submission, layer: 'platform', human: true, channel })
+  expect(received[0]!.channel).toEqual(channel)
+  expect(store.get(KV.input.records(receipt.triggerId))).toMatchObject({ envelope: { channel } })
+  store.close()
+})
+
+it('leaves a channel-less input without a channel, as before a Source could declare one', () => {
+  const { store, inputs, received } = setup()
+  inputs.submit(submission)
+  expect('channel' in received[0]!).toBe(false)
+  store.close()
+})
+
+it('refuses a channel naming another Source, an unknown channel key, and an address past its bounds', () => {
+  const { store, inputs, received } = setup()
+  const channel = { source: 'local', thread: 'local:qq:123', address: { platform: 'qq', target: '123' } }
+  const code = (value: unknown) => { try { inputs.submit(value) } catch (error) { return (error as InputError).code } }
+  // `channel.source` must be the submitting Source, whatever kind it is: another Source's address would let a trusted
+  // input write into a conversation its own Source never produced.
+  expect(code({ ...submission, channel: { ...channel, source: 'surfcore' } })).toBe('invalid')
+  expect(code({ ...submission, channel: { ...channel, conversation: 'c1' } })).toBe('invalid')
+  expect(code({ ...submission, channel: { ...channel, thread: '' } })).toBe('invalid')
+  expect(code({ ...submission, channel: { ...channel, address: Object.fromEntries(
+    Array.from({ length: 17 }, (_, index) => [`key${index}`, 'v'])) } })).toBe('invalid')
+  expect(code({ ...submission, channel: { ...channel, address: { target: 'x'.repeat(501) } } })).toBe('invalid')
+  expect(received).toHaveLength(0)
+  expect(store.keys(KV.input.records)).toEqual([])
+  store.close()
+})
+
