+/** The local input Source: no polling and no channel; it accepts InputEnvelopes delivered by the orchestration layer. */
+import { z } from 'zod'
+import type { SourceKind } from './kind.ts'
+
+const LocalConfig = z.object({}).strict()
+/**
+ * Accepts inputs handed to the orchestrator itself (`POST inputs`, later the CLI and loopback IPC).
+ * It polls nothing and has no outbound channel; `trusted` lets the Policy admit its inputs without sender lists.
+ * It never creates Tickets: its inputs become Triggers, and only a Decision creates a Ticket.
+ */
+export const localKind: SourceKind = {
+  kind: 'local',
+  title: { zh: '本机输入', en: 'Local input' },
+  description: { zh: '接受本机投递的输入（面板、CLI 与回环调用）；不轮询，也不直接创建工单。',
+    en: 'Accepts inputs delivered on this machine (panel, CLI and loopback callers); it polls nothing and never creates tickets.' },
+  schema: LocalConfig,
+  fields: [],
+  health: [],
+  trusted: true,
+}
