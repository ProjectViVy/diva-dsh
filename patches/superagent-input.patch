@@ -0,0 +1,92 @@
+/** Input intake: validates an InputEnvelope, dedupes it by its persisted receipt, and hands its Trigger to the Engine. */
+import { z } from 'zod'
+import { INPUT_LAYERS, type InputEnvelope, type InputReceipt, type InputRecord, type ReceiveResult, type Trigger } from '../core/index.ts'
+import { key } from '../core/ids.ts'
+import { KV } from '../kv.ts'
+import type { Store } from './store.ts'
+import type { Subject } from './subject.ts'
+
+/** The longest input text accepted; the management HTTP layer caps the whole request at 128 KiB. */
+export const MAX_INPUT_TEXT = 128 * 1024
+
+/** A rejected input submission; `code` tells the caller what to fix and maps to HTTP 400 (503 while stopping). */
+export class InputError extends Error {
+  constructor(readonly code: 'invalid' | 'subject_mismatch' | 'source_not_trusted' | 'unavailable', message: string) {
+    super(message)
+    this.name = 'InputError'
+  }
+}
+
+const SubmissionSchema = z.object({
+  subjectId: z.string().trim().min(1).max(200),
+  sourceId: z.string().regex(/^[a-z][a-z0-9-]*$/),
+  externalEventId: z.string().trim().min(1).max(200),
+  dedupeKey: z.string().trim().min(1).max(200),
+  layer: z.enum(INPUT_LAYERS).default('person'),
+  human: z.boolean().optional(),
+  payload: z.object({ text: z.string().trim().min(1).max(MAX_INPUT_TEXT),
+    url: z.url().refine(value => value.length <= 2000, 'URL exceeds 2000 characters').optional() }).strict(),
+  provenance: z.object({ actor: z.string().trim().min(1).max(200).optional(),
+    note: z.string().trim().min(1).max(500).optional() }).strict().optional(),
+}).strict()
+
+/** What `Inputs` uses from the Runtime; `receive` is the Engine's trigger intake, never a Ticket command. */
+export interface InputsHost {
+  readonly store: Store
+  readonly subject: Pick<Subject, 'binding'>
+  /** Whether a Source may submit inputs: installed, enabled, and marked `trusted`. */
+  trusted(source: string): boolean
+  receive(trigger: Trigger): ReceiveResult
+  /** Requests an orchestration pass; called after the submission commits. */
+  request(): void
+  closing(): boolean
+}
+
+/**
+ * Accepts InputEnvelopes for trusted Sources. Each submission becomes at most one Trigger, deduped by the Trigger ID
+ * derived from `sourceId` and `dedupeKey`; the envelope and its receipt are stored in the same transaction as intake,
+ * and the pass is requested only after that transaction commits. It never creates a Ticket.
+ */
+export class Inputs {
+  constructor(private readonly host: InputsHost) {}
+  submit(value: unknown): InputReceipt {
+    if (this.host.closing()) throw new InputError('unavailable', 'The orchestrator is stopping')
+    const parsed = SubmissionSchema.safeParse(value)
+    if (!parsed.success) {
+      const detail = parsed.error.issues.map(issue => `${issue.path.join('.') || 'input'}: ${issue.message}`).join('; ')
+      throw new InputError('invalid', `Invalid input: ${detail}`)
+    }
+    const input = parsed.data
+    const subjectId = this.host.subject.binding.subjectId
+    if (input.subjectId !== subjectId) {
+      throw new InputError('subject_mismatch', `The input names another subject; this installation is ${subjectId}`)
+    }
+    if (!this.host.trusted(input.sourceId)) {
+      throw new InputError('source_not_trusted', `Only a trusted local source may submit inputs; ${input.sourceId} cannot`)
+    }
+    const triggerId = key('input', input.sourceId, input.dedupeKey)
+    return this.host.store.atomic(() => {
+      const existing = this.host.store.get(KV.input.records(triggerId))
+      if (existing) {
+        // A dedupe key names one subject for its lifetime; a different subject must not inherit its Trigger.
+        if (existing.envelope.subjectId !== subjectId) throw new InputError('subject_mismatch', `The input names another subject; this installation is ${subjectId}`)
+        return { triggerId, outcome: 'duplicate' as const }
+      }
+      const receivedAt = new Date().toISOString()
+      const human = input.human ?? input.layer === 'person'
+      const envelope: InputEnvelope = { subjectId, sourceId: input.sourceId, externalEventId: input.externalEventId,
+        dedupeKey: input.dedupeKey, layer: input.layer, human, payload: input.payload, receivedAt,
+        provenance: { source: input.sourceId, at: receivedAt, externalId: input.externalEventId,
+          ...input.provenance?.actor ? { actor: input.provenance.actor } : {}, ...input.provenance?.note ? { note: input.provenance.note } : {} } }
+      const trigger: Trigger = { id: triggerId, source: input.sourceId, threads: [{ source: input.sourceId, id: subjectId }],
+        actor: { source: input.sourceId, id: subjectId }, human, addressed: 'direct', at: receivedAt, text: input.payload.text,
+        meta: { subjectId, input: { externalEventId: input.externalEventId, dedupeKey: input.dedupeKey, layer: input.layer } },
+        ...input.payload.url ? { url: input.payload.url } : {} }
+      const outcome = this.host.receive(trigger)
+      // `filtered` keeps its receipt too, so a redelivery is a duplicate rather than a second filtered Trigger.
+      this.host.store.set(KV.input.records(triggerId), { envelope, outcome } satisfies InputRecord)
+      if (outcome === 'stored') this.host.store.afterCommit(() => this.host.request())
+      return { triggerId, outcome }
+    })
+  }
+}
