index 0000000..daf213e
--- /dev/null
+++ b/tests/input.spec.ts
@@ -0,0 +1,93 @@
+import { mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { InputError, Inputs, MAX_INPUT_TEXT } from '../src/app/input.ts'
+import { Store } from '../src/app/store.ts'
+import { key, type Trigger } from '../src/core/index.ts'
+import { KV } from '../src/kv.ts'
+
+const SUBJECT = 'subject_11111111-1111-4111-8111-111111111111'
+const OTHER = 'subject_22222222-2222-4222-8222-222222222222'
+const TRIGGER_ID = key('input', 'local', 'dedupe-1')
+const binding = { subjectId: SUBJECT, displayName: 'Vivy', createdAt: '2026-11-03T00:00:00.000Z', schemaVersion: 1 }
+const submission = { subjectId: SUBJECT, sourceId: 'local', externalEventId: 'evt-1', dedupeKey: 'dedupe-1', payload: { text: '  hello  ' } }
+function setup(outcome: 'stored' | 'filtered' = 'stored', closing = false) {
+  const file = join(mkdtempSync(join(tmpdir(), 'orchestrator-input-')), 'orchestrator.sqlite')
+  const store = new Store(file)
+  const received: Trigger[] = [], requests: string[] = []
+  const inputs = new Inputs({ store, subject: { binding }, trusted: source => source === 'local',
+    receive: trigger => { received.push(trigger); return outcome },
+    request: () => { requests.push(store.get(KV.input.records(TRIGGER_ID)) ? 'committed' : 'early') },
+    closing: () => closing })
+  return { file, store, inputs, received, requests }
+}
+
+it('turns one InputEnvelope into one Trigger and records its receipt in the submitting transaction', () => {
+  const { store, inputs, received, requests } = setup()
+  const receipt = inputs.submit(submission)
+  expect(receipt).toEqual({ triggerId: TRIGGER_ID, outcome: 'stored' })
+  expect(received).toHaveLength(1)
+  expect(received[0]).toMatchObject({ id: TRIGGER_ID, source: 'local', threads: [{ source: 'local', id: SUBJECT }],
+    actor: { source: 'local', id: SUBJECT }, human: true, addressed: 'direct', text: 'hello',
+    meta: { subjectId: SUBJECT, input: { externalEventId: 'evt-1', dedupeKey: 'dedupe-1', layer: 'person' } } })
+  expect(new Date(received[0]!.at).toISOString()).toBe(received[0]!.at)
+  expect(store.get(KV.input.records(receipt.triggerId))).toMatchObject({ outcome: 'stored',
+    envelope: { subjectId: SUBJECT, sourceId: 'local', externalEventId: 'evt-1', dedupeKey: 'dedupe-1', layer: 'person', human: true,
+      payload: { text: 'hello' }, receivedAt: received[0]!.at,
+      provenance: { source: 'local', at: received[0]!.at, externalId: 'evt-1' } } })
+  // The pass is requested only after the receipt is committed, so a pass can never miss the input.
+  expect(requests).toEqual(['committed'])
+  store.close()
+})
+
+it('returns the first Trigger for a repeated dedupe key, also from another connection, and records nothing twice', () => {
+  const { file, store, inputs, received, requests } = setup()
+  expect(inputs.submit(submission)).toEqual({ triggerId: TRIGGER_ID, outcome: 'stored' })
+  expect(inputs.submit({ ...submission, externalEventId: 'evt-2', payload: { text: 'something else' } }))
+    .toEqual({ triggerId: TRIGGER_ID, outcome: 'duplicate' })
+  const reopened = new Store(file)
+  const restarted = new Inputs({ store: reopened, subject: { binding }, trusted: () => true,
+    receive: () => { throw new Error('a duplicate must not reach intake') }, request: () => {}, closing: () => false })
+  expect(restarted.submit(submission)).toEqual({ triggerId: TRIGGER_ID, outcome: 'duplicate' })
+  expect(received).toHaveLength(1)
+  expect(requests).toEqual(['committed'])
+  expect(reopened.keys(KV.input.records)).toEqual([KV.input.records(TRIGGER_ID)])
+  store.close(); reopened.close()
+})
+
+it('records a filtered input as its receipt, asks for no pass, and dedupes a redelivery', () => {
+  const { store, inputs, requests } = setup('filtered')
+  expect(inputs.submit(submission)).toEqual({ triggerId: TRIGGER_ID, outcome: 'filtered' })
+  expect(store.get(KV.input.records(TRIGGER_ID))).toMatchObject({ outcome: 'filtered' })
+  expect(inputs.submit(submission)).toEqual({ triggerId: TRIGGER_ID, outcome: 'duplicate' })
+  expect(requests).toEqual([])
+  store.close()
+})
+
+it('carries the layer, human flag, URL and submitter provenance into the envelope and Trigger', () => {
+  const { store, inputs, received } = setup()
+  const receipt = inputs.submit({ ...submission, layer: 'schedule', human: true, payload: { text: 'daily', url: 'https://example.com/t' },
+    provenance: { actor: 'scheduler', note: 'morning run' } })
+  expect(received[0]).toMatchObject({ human: true, url: 'https://example.com/t', meta: { input: { layer: 'schedule' } } })
+  expect(store.get(KV.input.records(receipt.triggerId))).toMatchObject({ envelope: { layer: 'schedule',
+    provenance: { source: 'local', externalId: 'evt-1', actor: 'scheduler', note: 'morning run' } } })
+  store.close()
+})
+
+it('refuses an invalid payload, a foreign subject, an untrusted Source and a stopping orchestrator', () => {
+  const { store, inputs, received } = setup()
+  const code = (value: unknown) => { try { inputs.submit(value) } catch (error) { return (error as InputError).code } }
+  expect(code({ ...submission, payload: { text: '' } })).toBe('invalid')
+  expect(code({ ...submission, payload: { text: 'x'.repeat(MAX_INPUT_TEXT + 1) } })).toBe('invalid')
+  expect(code({ ...submission, unexpected: true })).toBe('invalid')
+  expect(code({ ...submission, subjectId: OTHER })).toBe('subject_mismatch')
+  expect(code({ ...submission, sourceId: 'github' })).toBe('source_not_trusted')
+  expect(received).toHaveLength(0)
+  expect(store.keys(KV.input.records)).toEqual([])
+  const stopping = setup('stored', true)
+  const stoppingCode = (() => { try { stopping.inputs.submit(submission) } catch (error) { return (error as InputError).code } })()
+  expect(stoppingCode).toBe('unavailable')
+  stopping.store.close()
+  store.close()
+})
