diff --git a/after/tests/schedule.spec.ts b/tests/schedule.spec.ts
new file mode 100644
index 0000000..8243455
--- /dev/null
+++ b/tests/schedule.spec.ts
@@ -0,0 +1,109 @@
+/** Schedule rules: each due slot becomes one local trusted Input, at most once. */
+import { expect, it, vi } from 'vitest'
+import { Schedules, type ScheduleState } from '../src/app/schedule.ts'
+
+const rule = { id: 'daily', enabled: true, everyMinutes: 60, text: '整理今天的记忆' }
+const HOUR = 3_600_000
+const first = (state: Map<string, ScheduleState>) => [...state.values()][0]
+
+function world(rules = [rule], options: { paused?: boolean; closing?: boolean; outcome?: string; state?: Map<string, ScheduleState> } = {}) {
+  const submitted: Record<string, unknown>[] = []
+  const state = options.state ?? new Map<string, ScheduleState>()
+  const host = {
+    store: { get: (key: string) => state.get(key), set: (key: string, value: ScheduleState) => { state.set(key, value) } },
+    inputs: { submit: vi.fn((input: Record<string, unknown>) => {
+      if (options.outcome === 'throw') throw Object.assign(new Error('unavailable'), { code: 'unavailable' })
+      submitted.push(input)
+      return { triggerId: `input:local:${String(input.dedupeKey)}`, outcome: options.outcome ?? 'stored' }
+    }) },
+    subject: { binding: { subjectId: 'subject_a' } },
+    settings: () => ({ schedule: { rules }, paused: options.paused ?? false }),
+    closing: () => options.closing ?? false,
+  }
+  return { schedules: new Schedules(host as never), submitted, state }
+}
+
+it('baselines the first sight of a rule without submitting anything', () => {
+  const h = world()
+  h.schedules.due(10 * HOUR)
+  expect(h.submitted).toEqual([])
+  expect(first(h.state)).toEqual({ everyMinutes: 60, slot: 10 })
+})
+
+it('submits one local trusted input on slot turnover, with the exact envelope', () => {
+  const h = world()
+  h.schedules.due(10 * HOUR)
+  h.schedules.due(11 * HOUR)
+  expect(h.submitted).toEqual([{ subjectId: 'subject_a', sourceId: 'local', externalEventId: 'schedule:daily:11',
+    dedupeKey: 'schedule:daily:11', layer: 'schedule', human: true, payload: { text: '整理今天的记忆' },
+    provenance: { actor: 'orchestrator', note: 'Schedule' } }])
+  expect(first(h.state)).toEqual({ everyMinutes: 60, slot: 11 })
+})
+
+it('fires once per slot and never twice', () => {
+  const h = world()
+  h.schedules.due(10 * HOUR)
+  h.schedules.due(11 * HOUR)
+  h.schedules.due(11 * HOUR + 59 * 60_000)
+  expect(h.submitted).toHaveLength(1)
+  h.schedules.due(12 * HOUR)
+  expect(h.submitted.map(input => input.dedupeKey)).toEqual(['schedule:daily:11', 'schedule:daily:12'])
+})
+
+it('advances on a duplicate receipt so a replay cannot submit the same slot every pass', () => {
+  const h = world([rule], { outcome: 'duplicate' })
+  h.schedules.due(10 * HOUR)
+  h.schedules.due(11 * HOUR)
+  h.schedules.due(11 * HOUR + 1_000)
+  expect(h.submitted).toHaveLength(1)
+  expect(first(h.state)).toEqual({ everyMinutes: 60, slot: 11 })
+})
+
+it('leaves the slot unwritten when the input is refused, so a later pass retries it', () => {
+  const state = new Map<string, ScheduleState>()
+  const failing = world([rule], { outcome: 'throw', state })
+  failing.schedules.due(10 * HOUR)
+  expect(() => failing.schedules.due(11 * HOUR)).toThrow('unavailable')
+  expect(first(state)).toEqual({ everyMinutes: 60, slot: 10 })
+  const recovered = world([rule], { state })
+  recovered.schedules.due(11 * HOUR)
+  expect(recovered.submitted.map(input => input.dedupeKey)).toEqual(['schedule:daily:11'])
+})
+
+it('runs no rule while paused, disabled or closing', () => {
+  const paused = world([rule], { paused: true })
+  paused.schedules.due(10 * HOUR); paused.schedules.due(11 * HOUR)
+  expect(paused.submitted).toEqual([])
+  expect(paused.state.size).toBe(0)
+  const disabled = world([{ ...rule, enabled: false }])
+  disabled.schedules.due(10 * HOUR); disabled.schedules.due(11 * HOUR)
+  expect(disabled.submitted).toEqual([])
+  const closing = world([rule], { closing: true })
+  closing.schedules.due(10 * HOUR); closing.schedules.due(11 * HOUR)
+  expect(closing.submitted).toEqual([])
+})
+
+it('rebaselines when the interval changes or the clock moves backwards, instead of firing at once', () => {
+  const changed = world()
+  changed.schedules.due(10 * HOUR)
+  const shorter = world([{ ...rule, everyMinutes: 30 }], { state: changed.state })
+  shorter.schedules.due(10 * HOUR + 30 * 60_000)
+  expect(shorter.submitted).toEqual([])
+  expect(first(changed.state)).toEqual({ everyMinutes: 30, slot: 21 })
+  shorter.schedules.due(10 * HOUR + 60 * 60_000)
+  expect(shorter.submitted).toHaveLength(1)
+
+  const backwards = world()
+  backwards.schedules.due(11 * HOUR)
+  backwards.schedules.due(10 * HOUR)
+  expect(backwards.submitted).toEqual([])
+  expect(first(backwards.state)).toEqual({ everyMinutes: 60, slot: 10 })
+})
+
+it('keeps several rules independent', () => {
+  const h = world([rule, { id: 'hourly', enabled: true, everyMinutes: 30, text: '看看有没有新消息' }])
+  h.schedules.due(10 * HOUR)
+  h.schedules.due(11 * HOUR)
+  expect(h.submitted.map(input => input.dedupeKey)).toEqual(['schedule:daily:11', 'schedule:hourly:22'])
+  expect(h.state.size).toBe(2)
+})
