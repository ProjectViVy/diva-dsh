diff --git a/after/src/app/schedule.ts b/src/app/schedule.ts
new file mode 100644
index 0000000..4633f10
--- /dev/null
+++ b/src/app/schedule.ts
@@ -0,0 +1,41 @@
+/** Runs enabled Schedule rules: each due slot becomes one local trusted Input, at most once. */
+import { KV } from '../kv.ts'
+import type { Settings } from '../policy.ts'
+import type { Inputs } from './input.ts'
+import type { Store } from './store.ts'
+
+/** What one Schedule rule remembers: the interval it was scheduled with, and the last slot it fired. */
+export interface ScheduleState { everyMinutes: number; slot: number }
+
+export interface SchedulesHost {
+  readonly store: Pick<Store, 'get' | 'set'>
+  readonly inputs: Pick<Inputs, 'submit'>
+  readonly subject: { binding: { subjectId: string } }
+  settings(): Pick<Settings, 'schedule' | 'paused'>
+  closing(): boolean
+}
+
+export class Schedules {
+  constructor(private readonly host: SchedulesHost) {}
+  /** Submit every rule whose current slot has not fired; called from each pass, never from a timer of its own. */
+  due(now = Date.now()): void {
+    if (this.host.closing()) return
+    const settings = this.host.settings()
+    if (settings.paused) return
+    for (const rule of settings.schedule.rules) {
+      if (!rule.enabled) continue
+      const slot = Math.floor(now / (rule.everyMinutes * 60_000))
+      const state = this.host.store.get(KV.schedule.rule(rule.id))
+      // First sight, a changed interval, and a clock that moved back all rebaseline instead of firing.
+      if (!state || state.everyMinutes !== rule.everyMinutes || slot < state.slot) {
+        this.host.store.set(KV.schedule.rule(rule.id), { everyMinutes: rule.everyMinutes, slot })
+        continue
+      }
+      if (slot === state.slot) continue
+      this.host.inputs.submit({ subjectId: this.host.subject.binding.subjectId, sourceId: 'local',
+        externalEventId: `schedule:${rule.id}:${slot}`, dedupeKey: `schedule:${rule.id}:${slot}`, layer: 'schedule', human: true,
+        payload: { text: rule.text }, provenance: { actor: 'orchestrator', note: 'Schedule' } })
+      this.host.store.set(KV.schedule.rule(rule.id), { everyMinutes: rule.everyMinutes, slot })
+    }
+  }
+}
