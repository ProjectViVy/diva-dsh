new file mode 100644
index 0000000..4ee9144
--- /dev/null
+++ b/src/app/snapshots.ts
@@ -0,0 +1,78 @@
+/** Captures the immutable context one Assignment runs under, and answers prompt pins for its worker. */
+import { createHash } from 'node:crypto'
+import { assembleContextFor, type Agent } from '@deepseek-ai/dsh-agent'
+import type { Assignment, ContextSnapshot, Ticket } from '../core/index.ts'
+import type { Variable } from './execution-environment.ts'
+import type { Store } from './store.ts'
+
+type SnapshotPromptContext = ReturnType<typeof assembleContextFor>
+interface SnapshotAgent {
+  id: string
+  ctx: { systemPrompt?: { assemble?: (context: SnapshotPromptContext) => Promise<{ sections: readonly { name: string; text: string }[] }> } }
+}
+/** The prompt and skill texts a snapshot digests: `Prompts` narrowed to what the digests read. */
+interface SnapshotPrompts {
+  current(): { revision: number; config: { skills: Record<string, string> } }
+  skills(config: { skills: Record<string, string> }): [string, string][]
+}
+interface SnapshotHost {
+  store: Pick<Store, 'contextSnapshots' | 'settings'>
+  prompts: SnapshotPrompts
+}
+
+/** Captures what each Assignment is pinned to, and answers the prompt revision its worker Session reads. */
+export class ContextSnapshots {
+  constructor(private readonly host: SnapshotHost) {}
+
+  /** Records what `agent` was pinned to; a retry of the same Assignment reuses the first snapshot. */
+  async capture(ticket: Ticket, assignment: Assignment, agent: Agent, environment: readonly Variable[]): Promise<ContextSnapshot> {
+    const existing = this.host.store.contextSnapshots.get(assignment.id)
+    if (existing) return existing
+    const version = this.host.prompts.current()
+    const sections = await this.assemble(agent)
+    const tools = Object.fromEntries(Object.entries(sections)
+      .filter(([name]) => name.startsWith('tool:'))
+      .map(([name, value]) => [name.slice(5), value]))
+    const settings = this.host.store.settings()
+    return this.host.store.contextSnapshots.save({
+      assignmentId: assignment.id,
+      ticketId: ticket.id,
+      sessionId: agent.id,
+      capturedAt: new Date().toISOString(),
+      promptRevision: version.revision,
+      skillsDigest: digest(this.host.prompts.skills(version.config)),
+      policyDigest: digest({ policy: settings.policy, eval: settings.eval }),
+      sections,
+      tools,
+      environmentDigest: digest(environment),
+      owners: {
+        actmem: sections['actmem:policy'] ?? 'absent',
+        mempalace: sections['mempalace:policy'] ?? 'absent',
+        laputa: sections['laputa:persona'] ?? 'absent',
+      },
+    })
+  }
+
+  /** The pinned prompt revision for a worker Session, when its snapshot exists. */
+  promptRevisionForSession(sessionId: string): number | undefined {
+    return this.host.store.contextSnapshots.forSession(sessionId)?.promptRevision
+  }
+
+  private async assemble(agent: Agent): Promise<Record<string, string>> {
+    const service = (agent as unknown as SnapshotAgent).ctx.systemPrompt
+    if (typeof service?.assemble !== 'function') return {}
+    const assembly = await service.assemble(assembleContextFor(agent))
+    return Object.fromEntries(assembly.sections.map(section => [section.name, digest(section.text)]))
+  }
+}
+
+/** sha256 over a canonical form, so object key order cannot change a digest. */
+function digest(value: unknown): string {
+  return createHash('sha256').update(typeof value === 'string' ? value : canonical(value), 'utf8').digest('hex')
+}
+function canonical(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value)
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`
+  const record = value as Record<string, unknown>
+  return `{${Object.keys(record).sort().map(key => `${JSON.stringify(key)}:${canonical(record[key])}`).join(',')}}`
+}
