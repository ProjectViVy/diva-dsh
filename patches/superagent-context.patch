+/** Context snapshots: what a worker was pinned to when its Assignment launched. */
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { afterEach, expect, it } from 'vitest'
+import { Sessions, type SessionsHost } from '../src/app/sessions.ts'
+import { ContextSnapshots } from '../src/app/snapshots.ts'
+import { Store } from '../src/app/store.ts'
+
+let directory: string
+let store: Store
+afterEach(() => { store?.close(); rmSync(directory, { recursive: true, force: true }) })
+function open() { directory = mkdtempSync(join(tmpdir(), 'snapshots-')); store = new Store(join(directory, 'db.sqlite')) }
+
+type Prompt = { revision: number; config: { skills: Record<string, string> } }
+function promptSet(revisions: number[]) {
+  const versions = new Map(revisions.map(revision => [revision, { revision, config: { skills: {} } } as Prompt]))
+  return {
+    current: () => versions.get(Math.max(...revisions))!,
+    version: (revision: number) => {
+      const version = versions.get(revision)
+      if (!version) throw new Error(`unknown revision ${revision}`)
+      return version
+    },
+    skills: () => [['github', 'skill body']] as [string, string][],
+  }
+}
+
+const agent = (sections?: { name: string; text: string }[], seen?: string[]) => ({
+  id: 'worker-t1',
+  ctx: sections === undefined ? {} : { systemPrompt: { assemble: async (context: { agent?: { id: string } }) => {
+    seen?.push(context.agent?.id ?? 'missing')
+    return { sections: context.agent === undefined ? sections.map(section => ({ ...section, text: '' })) : sections }
+  } } },
+}) as unknown as Agent
+const ticket = { id: 't1' } as never
+const assignment = { id: 'a1' } as never
+const environment = [{ key: 'DSH_X', value: '1', description: { zh: 'x', en: 'x' }, owner: 'executor' }]
+const EMPTY_DIGEST = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+
+it('captures the prompt revision, digests and owner sections', async () => {
+  open()
+  const snapshots = new ContextSnapshots({ store, prompts: promptSet([7]) })
+  const snapshot = await snapshots.capture(ticket, assignment, agent([
+    { name: 'persona', text: 'persona body' },
+    { name: 'mempalace:policy', text: 'mem rules' },
+    { name: 'laputa:persona', text: 'soul v3' },
+    { name: 'tool:shell', text: 'shell tool' },
+  ]), environment)
+  expect(snapshot.promptRevision).toBe(7)
+  expect(snapshot.skillsDigest).toMatch(/^[0-9a-f]{64}$/)
+  expect(snapshot.policyDigest).toMatch(/^[0-9a-f]{64}$/)
+  expect(snapshot.environmentDigest).toMatch(/^[0-9a-f]{64}$/)
+  expect(snapshot.sections.persona).toMatch(/^[0-9a-f]{64}$/)
+  expect(snapshot.tools).toEqual({ shell: expect.stringMatching(/^[0-9a-f]{64}$/) })
+  expect(snapshot.owners).toEqual({ actmem: 'absent', mempalace: snapshot.sections['mempalace:policy'],
+    laputa: snapshot.sections['laputa:persona'] })
+  expect(store.contextSnapshots.get('a1')).toEqual(snapshot)
+})
+
+it('passes the agent to prompt section providers', async () => {
+  open()
+  const seen: string[] = []
+  const snapshot = await new ContextSnapshots({ store, prompts: promptSet([7]) })
+    .capture(ticket, assignment, agent([{ name: 'mempalace:policy', text: 'mem rules' }], seen), environment)
+  expect(seen).toEqual(['worker-t1'])
+  expect(snapshot.sections['mempalace:policy']).not.toBe(EMPTY_DIGEST)
+  expect(snapshot.owners.mempalace).toBe(snapshot.sections['mempalace:policy'])
+})
+
+it('tolerates an agent without a system prompt service', async () => {
+  open()
+  const snapshot = await new ContextSnapshots({ store, prompts: promptSet([7]) })
+    .capture(ticket, assignment, agent(undefined), environment)
+  expect(snapshot.sections).toEqual({})
+  expect(snapshot.tools).toEqual({})
+  expect(snapshot.owners).toEqual({ actmem: 'absent', mempalace: 'absent', laputa: 'absent' })
+})
+
+it('keeps the first snapshot for an Assignment', async () => {
+  open()
+  const snapshots = new ContextSnapshots({ store, prompts: promptSet([7]) })
+  const first = await snapshots.capture(ticket, assignment, agent([{ name: 'persona', text: 'one' }]), environment)
+  const second = await snapshots.capture(ticket, assignment, agent([{ name: 'persona', text: 'two' }]), environment)
+  expect(second).toEqual(first)
+})
+
+it('answers the pinned revision for a session', async () => {
