+    sections: {}, tools: {}, environmentDigest: 'c'.repeat(64), owners: { actmem: 'absent', mempalace: 'absent', laputa: 'absent' } }
+  store.contextSnapshots.save({ ...base, assignmentId: 'a1', capturedAt: '2026-01-01T00:00:00.000Z', promptRevision: 7 })
+  store.contextSnapshots.save({ ...base, assignmentId: 'a2', capturedAt: '2026-01-02T00:00:00.000Z', promptRevision: 9 })
