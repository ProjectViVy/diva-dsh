diff --git a/tests/subject.spec.ts b/tests/subject.spec.ts
new file mode 100644
index 0000000..84e96a0
--- /dev/null
+++ b/tests/subject.spec.ts
@@ -0,0 +1,49 @@
+import { mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { Store } from '../src/app/store.ts'
+import { DEFAULT_SUBJECT_NAME, Subject } from '../src/app/subject.ts'
+import { SUBJECT_SCHEMA_VERSION } from '../src/core/model.ts'
+import { KV } from '../src/kv.ts'
+
+const ID = /^subject_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
+const path = () => join(mkdtempSync(join(tmpdir(), 'orchestrator-subject-')), 'orchestrator.sqlite')
+
+it('creates one subject on first open and keeps it across restarts', () => {
+  const file = path()
+  const first = new Store(file)
+  const subject = Subject.open(first)
+  expect(subject.binding).toMatchObject({ displayName: DEFAULT_SUBJECT_NAME, schemaVersion: SUBJECT_SCHEMA_VERSION })
+  expect(subject.binding.subjectId).toMatch(ID)
+  expect(new Date(subject.binding.createdAt).toISOString()).toBe(subject.binding.createdAt)
+  first.close()
+  const second = new Store(file)
+  expect(Subject.open(second).binding).toEqual(subject.binding)
+  second.close()
+})
+
+it('generates no second ID when another connection opens the same state, and refuses a tampered binding', () => {
+  const file = path()
+  const one = new Store(file), two = new Store(file)
+  let generated = 0
+  const subject = Subject.open(one, () => { generated++; return '11111111-1111-4111-8111-111111111111' })
+  const other = Subject.open(two, () => { generated++; return '22222222-2222-4222-8222-222222222222' })
+  expect(other.binding.subjectId).toBe(subject.binding.subjectId)
+  expect(generated).toBe(1)
+  // A malformed stored binding must fail startup, not become a new identity.
+  one.set(KV.subject.binding, { ...subject.binding, subjectId: 'not-a-subject' })
+  expect(() => Subject.open(two)).toThrow(/subject binding/)
+  expect(two.get(KV.subject.binding)).toMatchObject({ subjectId: 'not-a-subject' })
+  one.close(); two.close()
+})
+
+it('renames the display name and keeps the identity fields', () => {
+  const store = new Store(path())
+  const subject = Subject.open(store)
+  const created = subject.binding
+  expect(subject.rename('Vivy 本体')).toEqual({ ...created, displayName: 'Vivy 本体' })
+  expect(subject.binding.displayName).toBe('Vivy 本体')
+  expect(Subject.open(store).binding).toEqual(subject.binding)
+  store.close()
+})
