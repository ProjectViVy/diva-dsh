diff --git a/src/app/subject.ts b/src/app/subject.ts
new file mode 100644
index 0000000..c37380a
--- /dev/null
+++ b/src/app/subject.ts
@@ -0,0 +1,58 @@
+/** The installation's subject binding, created once in the Store and never regenerated. */
+import { randomUUID } from 'node:crypto'
+import { z } from 'zod'
+import { SUBJECT_SCHEMA_VERSION, type SubjectBinding } from '../core/model.ts'
+import { KV } from '../kv.ts'
+import type { Store } from './store.ts'
+
+/** The display name a new subject gets until a person renames it. */
+export const DEFAULT_SUBJECT_NAME = 'Vivy'
+/** Mirrors the subject ID pattern in `plugins/_shared/contracts.mjs`; dsh-superagent does not import plugin source. */
+const SUBJECT_ID = /^subject_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
+const SubjectBindingSchema = z.object({
+  subjectId: z.string().regex(SUBJECT_ID),
+  displayName: z.string().min(1),
+  createdAt: z.string(),
+  schemaVersion: z.literal(SUBJECT_SCHEMA_VERSION),
+}).strict()
+
+const invalid = (detail: string): Error =>
+  new Error(`The stored subject binding is invalid; restore it from a backup instead of creating a new subject: ${detail}`)
+function readBinding(store: Store): SubjectBinding | undefined {
+  let stored: unknown
+  try { stored = store.get(KV.subject.binding) } catch (error) { throw invalid(String(error)) }
+  if (stored === undefined) return undefined
+  const parsed = SubjectBindingSchema.safeParse(stored)
+  if (!parsed.success) throw invalid(parsed.error.message)
+  return parsed.data
+}
+
+/**
+ * Owns the installation's stable subject identity: one `subject_<uuid>` created on first start, kept in the Store's KV area,
+ * and never replaced. Renaming changes only the display name; a malformed stored binding fails instead of generating a new ID.
+ * The state directory lock guarantees one process performs the first write.
+ */
+export class Subject {
+  private constructor(private readonly store: Store, private current: SubjectBinding) {}
+  static open(store: Store, generate: () => string = randomUUID, now: () => string = () => new Date().toISOString()): Subject {
+    const binding = store.atomic(() => {
+      const existing = readBinding(store)
+      if (existing) return existing
+      const created: SubjectBinding = { subjectId: `subject_${generate()}`, displayName: DEFAULT_SUBJECT_NAME, createdAt: now(),
+        schemaVersion: SUBJECT_SCHEMA_VERSION }
+      store.set(KV.subject.binding, created)
+      return created
+    })
+    return new Subject(store, binding)
+  }
+  get binding(): SubjectBinding { return this.current }
+  rename(displayName: string): SubjectBinding {
+    return this.store.atomic(() => {
+      const current = readBinding(this.store)
+      if (!current) throw new Error('The subject binding is missing; start dsh-superagent with its state directory intact')
+      const next = SubjectBindingSchema.parse({ ...current, displayName })
+      this.store.set(KV.subject.binding, next)
+      return this.current = next
+    })
+  }
+}
