+  commit(payload: VoiceEffectPayload, options: { key: string; deliver?: () => Promise<VoiceEffectResult>; timeoutMs?: number }): Promise<VoiceEffectResult & { ok: true }>
+  /** Drops a queued send; a running or terminal row is reported instead of cancelled. */
+  cancel(key: string): { cancelled: boolean; state?: string; inFlight?: boolean }
+  /** Reads a send's state without changing it. */
+  status(key: string): { state?: string; inFlight?: boolean; externalId?: string } | undefined
+}
 export interface SourceHost {
   readonly sources: SourceRegistry
   /** Returns the context for one Source kind; its `report` writes only the health entries declared by the kind. */
   context(kind: { kind: string; health: readonly string[] }): SourceContext
+  /** Effect-backed voice sends, present when the runtime wired a voice host. */
+  readonly voice?: VoiceEffectHost
 }
