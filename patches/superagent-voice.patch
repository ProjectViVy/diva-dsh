diff --git a/after2/src/app/voice-effects.ts b/src/app/voice-effects.ts
new file mode 100644
index 0000000..c105d7e
--- /dev/null
+++ b/src/app/voice-effects.ts
@@ -0,0 +1,87 @@
+import { Failed, Unknown, type EffectRecord, type EffectResult, type Effects } from './effects.ts'
+import type { VoiceEffectHost, VoiceEffectPayload, VoiceEffectResult } from '../sources/host.ts'
+
+const POLL_MS = 100
+const DELIVERY_TIMEOUT_MS = 135_000
+
+/**
+ * Exposes voice sends as `voice` effects, so a bridge delivery is recorded once and can be traced after a crash.
+ * A send whose outcome is unknown is never dispatched again; the caller checks the bridge before retrying.
+ */
+export class VoiceEffects implements VoiceEffectHost {
+  private readonly deliverers = new Map<string, () => Promise<VoiceEffectResult>>()
+  private readonly waiting = new Map<string, Promise<VoiceEffectResult & { ok: true }>>()
+  private readonly cancelled = new Set<string>()
+  private readonly results = new Map<string, VoiceEffectResult>()
+
+  constructor(private readonly effects: Effects) {
+    effects.handle('voice', (payload, key) => this.run(payload, key), {
+      record: true, interrupted: 'unknown', retryUnknown: false, retry: [2_000, 30_000],
+    })
+  }
+
+  private async run(payload: VoiceEffectPayload, key: string): Promise<EffectResult> {
+    if (payload.external) return payload.external.messageId ? { externalId: payload.external.messageId } : {}
+    const deliver = this.deliverers.get(key)
+    if (!deliver) throw new Failed(`No voice deliverer is registered for ${key}`)
+    try {
+      const result = await deliver()
+      this.results.set(key, result)
+      return result.messageId ? { externalId: String(result.messageId) } : {}
+    } catch (error) {
+      // The bridge may have accepted the message before failing; retrying could send it twice.
+      throw new Unknown(String(error))
+    } finally { this.deliverers.delete(key) }
+  }
+
+  async commit(payload: VoiceEffectPayload, options: { key: string; deliver?: () => Promise<VoiceEffectResult>; timeoutMs?: number }): Promise<VoiceEffectResult & { ok: true }> {
+    const key = options.key
+    const pending = this.waiting.get(key)
+    if (pending) return pending
+    const existing = this.effects.get('voice', key)
+    if (existing?.state === 'sent') return { ok: true, ...(existing.externalId ? { messageId: existing.externalId } : {}) }
+    if (existing) throw new Error(`voice effect ${key} is ${existing.state}${existing.inFlight ? ' (in flight)' : ''}; check the bridge before retrying`)
+    if (!this.effects.isStarted) {
+      if (!payload.external) throw new Error('voice effects have not started; the message was not sent')
+      this.effects.enqueue('voice', key, payload, { idempotencyKey: key })
+      return { ok: true, ...payload.external }
+    }
+    if (options.deliver) this.deliverers.set(key, options.deliver)
+    const promise = (async () => {
+      this.effects.enqueue('voice', key, payload, { idempotencyKey: key })
+      const record = await this.wait(key, options.timeoutMs ?? DELIVERY_TIMEOUT_MS)
+      if (record.state !== 'sent') throw new Error(`voice effect ${key} is ${record.state}`)
+      return { ok: true as const, ...(this.results.get(key) ?? {}), ...(record.externalId ? { messageId: record.externalId } : {}) }
+    })()
+    this.waiting.set(key, promise)
+    try { return await promise } finally {
+      this.waiting.delete(key); this.deliverers.delete(key); this.cancelled.delete(key); this.results.delete(key)
+    }
+  }
+
+  cancel(key: string) {
+    const record = this.effects.get('voice', key)
+    if (!record) return { cancelled: false }
+    if (record.inFlight || record.state !== 'pending') return { cancelled: false, state: record.state, inFlight: record.inFlight }
+    this.effects.cancel('voice', key)
+    this.deliverers.delete(key)
+    if (this.waiting.has(key)) this.cancelled.add(key)
+    return { cancelled: true, state: record.state, inFlight: false }
+  }
+
+  status(key: string) {
+    const record = this.effects.get('voice', key)
+    return record ? { state: record.state, inFlight: record.inFlight, externalId: record.externalId } : undefined
+  }
+
+  private async wait(key: string, timeoutMs: number): Promise<EffectRecord> {
+    const deadline = Date.now() + timeoutMs
+    for (;;) {
+      if (this.cancelled.has(key)) throw new Error(`voice effect ${key} was cancelled`)
+      const record = this.effects.get('voice', key)
+      if (record && (record.state === 'sent' || record.state === 'failed' || record.state === 'unknown')) return record
+      if (Date.now() >= deadline) { if (record) return record; throw new Error(`voice effect ${key} did not start`) }
+      await new Promise(resolve => setTimeout(resolve, POLL_MS))
+    }
+  }
+}
