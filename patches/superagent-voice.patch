diff --git a/after2/tests/voice-effects.spec.ts b/tests/voice-effects.spec.ts
new file mode 100644
index 0000000..9e1ba12
--- /dev/null
+++ b/tests/voice-effects.spec.ts
@@ -0,0 +1,100 @@
+/** Voice sends as `voice` effects: a single delivery per key, external receipts, and no automatic retry of an unknown send. */
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, expect, it } from 'vitest'
+import { Effects } from '../src/app/effects.ts'
+import { VoiceEffects } from '../src/app/voice-effects.ts'
+import { Store } from '../src/app/store.ts'
+import { HealthBoard } from '../src/infra/health.ts'
+import { deferred, waitUntil } from './fixtures/async.ts'
+
+let directory: string
+let store: Store
+let clock: number
+let effects: Effects
+let voice: VoiceEffects
+beforeEach(() => {
+  directory = mkdtempSync(join(tmpdir(), 'voice-effects-'))
+  store = new Store(join(directory, 'db.sqlite'))
+  clock = Date.parse('2026-09-09T00:00:00Z')
+  effects = new Effects(store, new HealthBoard(), () => clock)
+  effects.start()
+  voice = new VoiceEffects(effects)
+})
+afterEach(() => { store.close(); rmSync(directory, { recursive: true, force: true }) })
+
+const send = { target: 'qq:group:1', action: 'voice' as const, file: 'clip.wav', channel: 'operator' as const }
+
+it('reports whether dispatch started', () => {
+  expect(effects.isStarted).toBe(true)
+})
+
+it('delivers once and keeps the receipt on the sent row', async () => {
+  let calls = 0
+  const result = await voice.commit(send, {
+    key: 's1',
+    deliver: async () => { calls += 1; return { messageId: 'm1', verified: true } },
+  })
+  expect(calls).toBe(1)
+  expect(result).toMatchObject({ ok: true, messageId: 'm1', verified: true })
+  expect(effects.get('voice', 's1')).toMatchObject({ state: 'sent', externalId: 'm1', inFlight: false })
+})
+
+it('coalesces concurrent commits of one key into a single delivery', async () => {
+  let calls = 0
+  const deliver = async () => { calls += 1; return { messageId: 'm2' } }
+  const [first, second] = await Promise.all([
+    voice.commit(send, { key: 's2', deliver }),
+    voice.commit(send, { key: 's2', deliver }),
+  ])
+  expect(calls).toBe(1)
+  expect(first).toEqual(second)
+  expect(effects.get('voice', 's2')).toMatchObject({ state: 'sent', externalId: 'm2' })
+})
+
+it('records an external receipt without a deliverer', async () => {
+  const result = await voice.commit({ ...send, external: { messageId: 'far-1', verified: true } }, { key: 's3' })
+  expect(result).toMatchObject({ ok: true, messageId: 'far-1' })
+  expect(effects.get('voice', 's3')).toMatchObject({ state: 'sent', externalId: 'far-1' })
+})
+
+it('leaves a failed delivery unknown and does not deliver again after the clock advances', async () => {
+  let calls = 0
+  await expect(voice.commit(send, {
+    key: 's4',
+    deliver: async () => { calls += 1; throw new Error('bridge timeout') },
+  })).rejects.toThrow()
+  expect(calls).toBe(1)
+  expect(effects.get('voice', 's4')).toMatchObject({ state: 'unknown', inFlight: false })
+  clock += 60_000
+  effects.kick()
+  await effects.idle()
+  expect(calls).toBe(1)
+  expect(effects.get('voice', 's4')).toMatchObject({ state: 'unknown' })
+})
+
+it('refuses to cancel an in-flight or terminal send', async () => {
+  const gate = deferred<{ messageId: string }>()
+  const sending = voice.commit(send, { key: 's5', deliver: () => gate.promise })
+  await waitUntil(() => effects.get('voice', 's5')?.inFlight === true)
+  expect(voice.cancel('s5')).toMatchObject({ cancelled: false, inFlight: true })
+  gate.resolve({ messageId: 'm5' })
+  await sending
+  expect(voice.cancel('s5')).toMatchObject({ cancelled: false, state: 'sent' })
+  expect(effects.get('voice', 's5')).toMatchObject({ state: 'sent' })
+})
+
+it('cancels a queued commit and rejects its waiter', async () => {
+  const gate = deferred<{ messageId: string }>()
+  const first = voice.commit(send, { key: 's6a', deliver: () => gate.promise })
+  await waitUntil(() => effects.get('voice', 's6a')?.inFlight === true)
+  // The kind runs one send at a time, so this row waits in the queue.
+  const queued = voice.commit(send, { key: 's6b', deliver: async () => ({ messageId: 'm6b' }) })
+  await waitUntil(() => effects.get('voice', 's6b')?.state === 'pending')
+  expect(voice.cancel('s6b')).toMatchObject({ cancelled: true, state: 'pending' })
+  await expect(queued).rejects.toThrow('was cancelled')
+  expect(effects.get('voice', 's6b')).toBeUndefined()
+  gate.resolve({ messageId: 'm6a' })
+  await first
+})
