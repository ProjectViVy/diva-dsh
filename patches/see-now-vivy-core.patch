diff --git a/test/lifecycle-api.test.mjs b/test/lifecycle-api.test.mjs
new file mode 100644
index 0000000..84107f4
--- /dev/null
+++ b/test/lifecycle-api.test.mjs
@@ -0,0 +1,96 @@
+import test, { before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+let home;
+let server;
+let base;
+let calls;
+
+before(async () => {
+  home = mkdtempSync(join(tmpdir(), 'dsh-see-life-api-'));
+  process.env.DSH_HOME = home;
+  calls = [];
+  const { createSettingsApi, ROUTE_PREFIX } = await import('../src/settings-api.mjs');
+  const lifecycle = {
+    status: () => ({ capture: { running: calls.includes('start') }, window: { alive: false }, loop: null }),
+    start: async () => { calls.push('start'); return { ok: true, note: 'screen' }; },
+    stop: async () => { calls.push('stop'); return { ok: true }; },
+    open: async () => { calls.push('open'); return { ok: true, note: 'opened' }; },
+    close: async () => { calls.push('close'); return { ok: true }; },
+  };
+  const handle = createSettingsApi({ lifecycle });
+  server = http.createServer((req, res) => {
+    handle(req, res, undefined).catch((err) => {
+      res.writeHead(500);
+      res.end(String(err?.message ?? err));
+    });
+  });
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  base = `http://127.0.0.1:${server.address().port}${ROUTE_PREFIX}`;
+});
+
+after(() => {
+  server?.close();
+  if (home) rmSync(home, { recursive: true, force: true });
+});
+
+async function getLifecycle() {
+  const res = await fetch(`${base}/lifecycle`);
+  return { code: res.status, body: await res.json() };
+}
+
+async function act(action) {
+  const res = await fetch(`${base}/lifecycle`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ action }),
+  });
+  return { code: res.status, body: await res.json() };
+}
+
+test('GET /lifecycle 回状态、流水路径与空记录', async () => {
+  const { code, body } = await getLifecycle();
+  assert.equal(code, 200);
+  assert.equal(body.ok, true);
+  assert.equal(body.status.capture.running, false);
+  assert.equal(body.journal.path, join(home, 'see-now', 'lifecycle.jsonl'));
+  assert.deepEqual(body.journal.events, []);
+});
+
+test('POST /lifecycle start 落到生命周期回调并写一条记录', async () => {
+  const { code, body } = await act('start');
+  assert.equal(code, 200);
+  assert.equal(body.ok, true);
+  assert.equal(body.action, 'start');
+  assert.deepEqual(calls, ['start']);
+  assert.equal(body.journal.events[0].action, 'start');
+  assert.equal(body.journal.events[0].note, 'screen');
+  assert.equal(body.status.capture.running, true);
+});
+
+test('window-open / stop 都走同一条路由', async () => {
+  await act('window-open');
+  await act('stop');
+  const { body } = await getLifecycle();
+  assert.deepEqual(calls, ['start', 'open', 'stop']);
+  assert.deepEqual(body.journal.events.map((event) => event.action), ['stop', 'window-open', 'start']);
+});
+
+test('未知 action 是 400，不会误写', async () => {
+  const before = (await getLifecycle()).body.journal.events.length;
+  const { code, body } = await act('nonsense');
+  assert.equal(code, 400);
+  assert.equal(body.ok, false);
+  assert.equal((await getLifecycle()).body.journal.events.length, before);
+});
+
+test('clear 只清流水，配置不碰', async () => {
+  const { code, body } = await act('clear');
+  assert.equal(code, 200);
+  assert.equal(body.ok, true);
+  assert.deepEqual(body.journal.events.map((event) => event.action), ['clear']);
+});
diff --git a/test/lifecycle-store.test.mjs b/test/lifecycle-store.test.mjs
new file mode 100644
index 0000000..64bd6cc
--- /dev/null
+++ b/test/lifecycle-store.test.mjs
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { appendLifecycle, clearLifecycle, lifecyclePath, readLifecycle } from '../src/lifecycle-store.mjs';
+
+test('生命周期流水只记动作，最新在前，可清空', (t) => {
+  const home = mkdtempSync(join(tmpdir(), 'see-now-life-'));
+  t.after(() => rmSync(home, { recursive: true, force: true }));
+  const env = { ...process.env, DSH_HOME: home };
+
+  appendLifecycle({ action: 'start', ok: true, note: 'screen' }, env);
+  appendLifecycle({ action: 'stop', ok: false, note: 'no-session' }, env);
+
+  const { path, events } = readLifecycle({ env });
+  assert.equal(path, lifecyclePath(env));
+  assert.equal(path, join(home, 'see-now', 'lifecycle.jsonl'));
+  assert.equal(events.length, 2);
+  assert.equal(events[0].action, 'stop');
+  assert.equal(events[0].ok, false);
+  assert.equal(events[1].action, 'start');
+  assert.equal(events[1].note, 'screen');
+
+  clearLifecycle(env);
+  assert.deepEqual(readLifecycle({ env }).events, []);
+});
+
+test('坏行不会让整份记录读不出来', (t) => {
+  const home = mkdtempSync(join(tmpdir(), 'see-now-life-bad-'));
+  t.after(() => rmSync(home, { recursive: true, force: true }));
+  const env = { ...process.env, DSH_HOME: home };
+  appendLifecycle({ action: 'start', ok: true }, env);
+  const path = lifecyclePath(env);
+  writeFileSync(path, `${readFileSync(path, 'utf8')}not-json\n`, 'utf8');
+  const { events } = readLifecycle({ env });
+  assert.equal(events.length, 1);
+  assert.equal(events[0].action, 'start');
+});
+
+// 面板在调试页每 1.5 秒读一次：只读尾巴，但不能因此少一条或多出半截行。
+test('limit 只返回最近几条，且从文件尾部读起', (t) => {
+  const home = mkdtempSync(join(tmpdir(), 'see-now-life-limit-'));
+  t.after(() => rmSync(home, { recursive: true, force: true }));
+  const env = { ...process.env, DSH_HOME: home };
+
+  // 每条都带一段注释，把总长撑过单次读的预算，逼出「从中间切进来」的分支。
+  for (let i = 1; i <= 300; i += 1) {
+    appendLifecycle({ action: 'start', ok: true, note: `#${i} ${'x'.repeat(200)}` }, env);
+  }
+
+  const { path, events } = readLifecycle({ limit: 5, env });
+  assert.equal(path, lifecyclePath(env));
+  assert.equal(events.length, 5);
+  assert.deepEqual(events.map((event) => event.note.split(' ')[0]), ['#300', '#299', '#298', '#297', '#296']);
+
+  // 半截行不能变成一条坏记录混在里面
+  assert.ok(events.every((event) => typeof event.action === 'string'));
+});
