{
  "name": "dsh-superagent-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A project-local source checkout and launcher for DeepSeek Harness and dsh-superagent.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:surfcore": "node scripts/setup-surfcore.mjs",
    "setup:components": "node scripts/setup-components.mjs",
    "setup:mempalace": "node scripts/setup-mempalace.mjs",
    "setup:continual-harness": "node scripts/setup-continual-harness.mjs",
    "setup:laputa": "node scripts/setup-laputa.mjs",
    "setup:vivy-tone": "node scripts/setup-vivy-tone.mjs",
    "setup:surfcore-adapter": "node scripts/setup-surfcore-adapter.mjs",
    "setup:third-party": "node scripts/setup-third-party.mjs",
    "start": "node scripts/vivy-dsh.mjs start",
    "stop": "node scripts/vivy-dsh.mjs stop",
    "restart": "node scripts/vivy-dsh.mjs restart",
    "status": "node scripts/vivy-dsh.mjs status",
    "proxy": "node scripts/vivy-dsh.mjs proxy",
    "build:bundle": "node scripts/build-bundle.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "stream-chain": "4.4.1",
    "stream-json": "3.8.0",
    "tar": "7.5.22"
  }
}
